[
  {
    "name": "organizations",
    "managedOrigins": ["DATA_PACK", "SEED"],
    "fields": [
      {
        "key": "name",
        "type": "string",
        "required": true,
        "maxLength": 250,
        "label": "Tên tổ chức"
      },
      {
        "key": "code",
        "type": "string",
        "required": true,
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
        "label": "Mã",
        "unique": true
      },
      {
        "key": "kind",
        "type": "select",
        "required": true,
        "options": ["BUYER", "SUPPLIER", "INTERNAL"],
        "label": "Loại"
      },
      {
        "key": "email",
        "type": "email",
        "maxLength": 254,
        "label": "Email"
      },
      {
        "key": "taxCode",
        "type": "string",
        "maxLength": 14,
        "pattern": "^(\\d{10}(-\\d{3})?|\\d{12})$",
        "label": "Mã số thuế"
      },
      {
        "key": "address",
        "type": "textarea",
        "maxLength": 250,
        "label": "Địa chỉ"
      }
    ]
  },
  {
    "name": "users",
    "fields": [
      {
        "key": "displayName",
        "type": "string",
        "required": true,
        "maxLength": 250,
        "label": "Họ tên"
      },
      {
        "key": "email",
        "type": "email",
        "required": true,
        "maxLength": 254,
        "label": "Email",
        "unique": true
      },
      {
        "key": "title",
        "type": "string",
        "maxLength": 250,
        "label": "Chức danh"
      },
      {
        "key": "role",
        "type": "select",
        "required": true,
        "options": [
          "CONTRACT_OWNER",
          "FINANCE_APPROVER",
          "SECONDARY_APPROVER",
          "LEGAL_REVIEWER",
          "ADMIN_AUDITOR",
          "SYSTEM_ADMIN",
          "AUDITOR",
          "SUPPLIER",
          "ORG_ADMIN"
        ],
        "label": "Vai trò"
      },
      {
        "key": "organizationId",
        "type": "string",
        "required": true,
        "ref": "organizations",
        "maxLength": 250,
        "label": "Tổ chức"
      },
      {
        "key": "partyId",
        "type": "string",
        "maxLength": 250,
        "label": "Bên Data Pack"
      },
      {
        "key": "active",
        "type": "boolean",
        "label": "Hoạt động"
      }
    ]
  },
  {
    "name": "contract-drafts",
    "managedOrigins": ["DATA_PACK", "SEED", "APP"],
    "fields": [
      {
        "key": "code",
        "type": "string",
        "required": true,
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      {
        "key": "title",
        "type": "string",
        "required": true,
        "maxLength": 250
      },
      {
        "key": "supplierId",
        "type": "string",
        "required": true,
        "ref": "organizations",
        "maxLength": 250
      },
      {
        "key": "contractType",
        "type": "select",
        "required": true,
        "options": [
          "GOODS_SUPPLY",
          "SERVICES",
          "SOFTWARE_IMPLEMENTATION",
          "MAINTENANCE"
        ]
      }
    ]
  },
  {
    "name": "milestone-templates",
    "managedOrigins": ["DATA_PACK"],
    "fields": [
      {
        "key": "name",
        "type": "string",
        "required": true,
        "maxLength": 250
      },
      {
        "key": "workflowTemplate",
        "type": "select",
        "required": true,
        "options": [
          "WF_GOODS_4STAGE",
          "WF_SERVICE_4STAGE",
          "WF_SOFTWARE_5STAGE",
          "WF_MAINTENANCE_3STAGE"
        ]
      },
      {
        "key": "sequence",
        "type": "number",
        "required": true,
        "min": 1,
        "max": 20,
        "integer": true
      },
      {
        "key": "milestoneType",
        "type": "string",
        "required": true,
        "maxLength": 250
      },
      {
        "key": "requiredEvents",
        "type": "string",
        "required": true,
        "maxLength": 250
      },
      {
        "key": "paymentPercent",
        "type": "string",
        "required": true,
        "maxLength": 250,
        "pattern": "^(?:100(?:\\.0{1,2})?|\\d{1,2}(?:\\.\\d{1,2})?)$"
      },
      {
        "key": "latePenalty",
        "type": "boolean"
      },
      {
        "key": "offsetDays",
        "type": "number",
        "required": true,
        "min": 0,
        "max": 36500,
        "integer": true
      }
    ]
  },
