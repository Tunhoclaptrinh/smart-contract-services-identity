        "maxLength": 250
      },
      {
        "key": "resource",
        "type": "string",
        "maxLength": 250
      },
      {
        "key": "actorId",
        "type": "string",
        "maxLength": 250
      },
      {
        "key": "recordId",
        "type": "string",
        "maxLength": 250
      }
