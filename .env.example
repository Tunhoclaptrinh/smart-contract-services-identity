# Local development. Copy to .env.
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
# file (local, one process) | mongo (MONGO_URI, replica set) | postgres (DATABASE_URL)
STORAGE_DRIVER=file
DATA_DIR=.data
MONGO_URI=mongodb://127.0.0.1:27017/codecash?replicaSet=rs0
DATABASE_URL=postgres://codecash:codecash@127.0.0.1:5432/codecash
PG_SCHEMA=codecash
# Access tokens are RS256. Identity signs with JWT_PRIVATE_KEY (PEM; "\n" escapes allowed), required
# in production; development generates a key once in JWT_KEY_DIR (default .data-jwt).
JWT_PRIVATE_KEY=
JWT_KEY_DIR=
# Production without JWT_PRIVATE_KEY: generate one into JWT_KEY_DIR (demo stack on a volume only).
JWT_GENERATE_KEY=
# Verifiers (gateway, every other service): identity's public key, or its JWKS endpoint.
JWT_PUBLIC_KEY=
JWKS_URL=http://127.0.0.1:3001/api/v1/.well-known/jwks.json
# Lifetime of an access token; identity renews it with a refresh token (REFRESH_TTL_DAYS).
TOKEN_TTL=15m
REFRESH_TTL_DAYS=14
# Addresses of the other services, for ServiceClient.fromEnv("<name>") (MS-R5).
IDENTITY_URL=http://127.0.0.1:3001
CONTRACT_URL=http://127.0.0.1:3002
SIGNING_URL=http://127.0.0.1:3004
EXECUTION_URL=http://127.0.0.1:3005
DECISION_URL=http://127.0.0.1:3006
PAYMENT_URL=http://127.0.0.1:3007
AUDIT_URL=http://127.0.0.1:3008
# Password of the seed accounts (default Passw0rd! in development).
SEED_PASSWORD=
# One-click demo sign-in (default on outside production).
DEMO_LOGIN=
# Self sign-up of a company with its account administrator (default on).
SIGNUP=
# Keys of the audit log (digests of personal values); default .data-trust next to the repo.
TRUST_DIR=
