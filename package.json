{
  "name": "btl-backend",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @sc/nest-common build && pnpm --filter ./service dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @sc/nest-common build && pnpm -r typecheck",
    "lint": "eslint --max-warnings 0 --no-error-on-unmatched-pattern packages service gateway",
    "format": "prettier --write --no-error-on-unmatched-pattern packages service gateway",
    "format:check": "prettier --check --no-error-on-unmatched-pattern packages service gateway",
    "test": "pnpm build && node --test packages/nest-common/test/*.test.mjs && pnpm --filter \"{./service}\" --filter \"{./gateway}\" --if-present test && node scripts/smoke-service.mjs",
    "check:base": "node scripts/check-base-untouched.mjs",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:up:pg": "docker compose -f infra/compose.yaml --profile postgres up -d --wait postgres",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "check:docs": "node scripts/check-docs-updated.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
